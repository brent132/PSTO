// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  USER
  ADMIN
  SETUP
  PROGRAM
}

model User {
  id               Int      @id @default(autoincrement())
  username         String   @unique
  firstName        String
  lastName         String
  middleName       String?
  suffix           String?
  password         String // store a HASH, not plain text
  profileImage     Bytes?
  profileImageMime String?
  role             Role     @default(USER)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  transactionsCreated    Transactions[]            @relation("UserTransactions")
  created_notifications  notifications[]           @relation("CreatedNotifications")
  notifications_received notification_recipients[] @relation("UserNotifications")
}

model Projects {
  id           Int       @id @default(autoincrement())
  project_code String    @unique
  project_name String
  fiscal_year  String?
  budget       Float?
  start_date   DateTime?
  end_date     DateTime?
  status       String?
  description  String?
  manager_name String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  transactions Transactions[]
}

model Categories {
  id            Int      @id @default(autoincrement())
  category_name String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  transactions Transactions[]
}

model Transactions {
  id               Int      @id @default(autoincrement())
  transaction_date DateTime
  project_code     String
  category_id      Int
  voucher_no       String
  particulars      String
  amount           Float
  status           String
  transaction_type String
  created_by       Int
  created_at       DateTime @default(now())
  fiscal_year      String
  updated_at       DateTime @updatedAt

  category Categories @relation(fields: [category_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  project  Projects   @relation(fields: [project_code], references: [project_code], onDelete: Restrict, onUpdate: Cascade)
  creator  User       @relation("UserTransactions", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

enum NotificationType {
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_STATUS_CHANGED
  TRANSACTION_CREATED
  TRANSACTION_UPDATED
  TRANSACTION_APPROVED
  TRANSACTION_REJECTED
  BUDGET_WARNING
  DEADLINE_WARNING
  SYSTEM
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
}

enum NotificationReferenceType {
  PROJECT
  TRANSACTION
  REPORT
  CATEGORY
  SYSTEM
}

model notifications {
  id       Int                  @id @default(autoincrement())
  title    String
  message  String
  type     NotificationType
  priority NotificationPriority @default(MEDIUM)

  created_by Int?
  creator    User? @relation("CreatedNotifications", fields: [created_by], references: [id], onDelete: SetNull)

  reference_type NotificationReferenceType?
  reference_id   Int?

  action_url String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  recipients notification_recipients[]

  @@index([created_by])
  @@index([type])
  @@index([priority])
  @@index([reference_type, reference_id])
  @@index([created_at])
  @@index([deleted_at])
}

model notification_recipients {
  id              Int @id @default(autoincrement())
  notification_id Int
  user_id         Int

  is_read Boolean   @default(false)
  read_at DateTime?

  is_hidden    Boolean   @default(false)
  delivered_at DateTime  @default(now())
  deleted_at   DateTime?

  notification notifications @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  user         User          @relation("UserNotifications", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([notification_id, user_id])
  @@index([user_id, is_read])
  @@index([user_id, delivered_at])
  @@index([notification_id])
  @@index([deleted_at])
}
