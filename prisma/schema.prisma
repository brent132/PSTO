// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id         Int     @id @default(autoincrement())
  username   String  @unique
  firstName  String
  lastName   String
  middleName String?
  suffix     String?
  password   String  // store a HASH, not plain text
  profileImage     Bytes?
  profileImageMime String?
  role             Role     @default(USER)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Projects {
  id           Int      @id @default(autoincrement())
  project_code String
  project_name String
  fiscal_year  String
  budget       Float
  start_date   DateTime
  end_date     DateTime
  status       String
  description  String
  manager_name String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

model Categories {
  id            Int            @id @default(autoincrement())
  category_name String
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  transactions  Transactions[]
}

model Transactions {
  id               Int         @id @default(autoincrement())
  transaction_date DateTime
  project_code     String
  category_id      Int
  voucher_no       String
  particulars      String
  amount           Float
  status           String
  transaction_type String
  created_by       String
  created_at       DateTime    @default(now())
  fiscal_year      String
  updated_at       DateTime    @updatedAt

category Categories @relation(fields: [category_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
}
