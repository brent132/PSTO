// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  USER
  ADMIN
  SETUP
  PROGRAM
}

model User {
  id               Int      @id @default(autoincrement())
  username         String   @unique
  firstName        String
  lastName         String
  middleName       String?
  suffix           String?
  password         String
  profileImage     Bytes?
  profileImageMime String?
  role             Role     @default(USER)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
}

model Projects {
  id            Int            @id @default(autoincrement())
  project_title String         @unique
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  deleted_at    DateTime?

  requirements  Requirements[]
}

model Requirements {
  id            Int       @id @default(autoincrement())
  project_id    Int
  requirement   String
  is_compiled   Boolean   @default(false)
  remarks       String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  project       Projects  @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([project_id])
}
